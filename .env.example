# Create .env from this file; never commit the real secret.
ANTHROPIC_API_KEY=
# Set to a model ID enabled on your Anthropic account.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Native Claude web search: 1 enables selective, source-grounded research.
ENABLE_WEB_SEARCH=1
PORT=3456
# Absolute path recommended for production persistence.
DATABASE_PATH=./data/anywhen.db
# Required in production behind HTTPS; only allow your actual origin.
APP_ORIGIN=http://localhost:3456
NODE_ENV=development
# Controls paid generations per guest/account per UTC day.
DAILY_GENERATION_LIMIT=40

# Optional cost estimates: update if your model pricing changes.
INPUT_USD_PER_M=2
OUTPUT_USD_PER_M=10
